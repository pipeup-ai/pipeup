{
  "name": "pipeup-addons",
  "private": true,
  "version": "0.5.1",
  "description": "Pipeup's add-ons (share, voice, live) and the private kit they share. Workspace tooling only; the add-ons are the @pipeup/* packages.",
  "type": "module",
  "workspaces": [
    "kit",
    "share",
    "voice",
    "live",
    "assist",
    "test"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "demo": "node examples/demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "pipeup": "file:../pipeup",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
