{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "*/src",
    "*/test",
    "e2e",
    "scripts",
    "examples/send-to-git/src",
    "examples/save-to-github/src",
    "examples/save-to-github/test",
    "../../../tools/updates.mjs"
  ]
}
