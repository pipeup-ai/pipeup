{
  "name": "@pipeup/live",
  "version": "0.4.1",
  "description": "Live comments and presence for Pipeup, peer to peer.",
  "license": "MIT",
  "author": "Pipeup contributors",
  "homepage": "https://pipeup-ai.github.io/pipeup/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pipeup-ai/pipeup.git",
    "directory": "libs/ts/addons/live"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/live.esm.js",
  "module": "./dist/live.esm.js",
  "types": "./dist/types/index.d.ts",
  "jsdelivr": "dist/live.min.js",
  "unpkg": "dist/live.min.js",
  "files": [
    "dist/*.js",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "pipeup": "0.4.1"
  },
  "pipeup": {
    "network": {
      "when": "after-consent",
      "to": [
        "nostr relays (the page may name them)",
        "stun.l.google.com",
        "stun.cloudflare.com",
        "other people live on this page"
      ],
      "says": "When you go live, you connect directly to other people viewing this page. They see your network address; the meeting-point services see your network address and when you connect, never your comments."
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/live.esm.js"
    },
    "./headless": {
      "import": "./dist/live.headless.js"
    },
    "./package.json": "./package.json"
  }
}
