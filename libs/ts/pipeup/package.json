{
  "name": "pipeup",
  "version": "0.5.0",
  "description": "Comments and feedback right on any HTML page: documents, slide decks and whole sites.",
  "keywords": [
    "comments",
    "feedback",
    "review",
    "annotations",
    "html",
    "ai",
    "agents"
  ],
  "license": "MIT",
  "author": "Pipeup contributors",
  "homepage": "https://pipeup-ai.github.io/pipeup/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pipeup-ai/pipeup.git",
    "directory": "libs/ts/pipeup"
  },
  "bugs": {
    "url": "https://github.com/pipeup-ai/pipeup/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/pipeup.esm.js",
  "module": "./dist/pipeup.esm.js",
  "types": "./dist/types/index.d.ts",
  "jsdelivr": "dist/pipeup.min.js",
  "unpkg": "dist/pipeup.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/pipeup.esm.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/pipeup.core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src test e2e && prettier --check src test e2e",
    "format": "prettier --write src test e2e",
    "check": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit && npm run lint && vitest run && npm run build && node scripts/size.mjs && npm run e2e",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
